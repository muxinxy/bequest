<?xml version="1.0" encoding="utf-8"?>
<!-- 默认禁明文 HTTP:本应用的 HTTP API/WebDAV/S3 备份均要求 HTTPS。
     该策略只约束 HTTP,不约束 FTP 等非 HTTP socket(明文 FTP 请自行评估)。
     自托管部署请经 HTTPS 反代暴露(见 server/README-deploy.md 的反代指引);
     debug 构建由 src/debug/res/xml 同名配置覆盖,允许本机明文联调。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
